# ============================================================
#  Auto-Apply config — copy this file to ".env" and fill it in.
#  The .env file is git-ignored, so your real data never gets pushed.
# ============================================================

# --- Google login (legacy fallback for the Naukri profile-refresh auto-login) ---
# Used only if NAUKRI_PASSWORD below is empty. Google blocks automated sign-in for
# many accounts, so NAUKRI_EMAIL / NAUKRI_PASSWORD is preferred for Naukri.
GOOGLE_EMAIL=you@gmail.com
GOOGLE_PASSWORD=your-google-password

# --- Naukri ---
# Naukri's own direct login (the Email ID / Password form on naukri.com/nlogin/login).
# PREFERRED over Google for Naukri: when NAUKRI_PASSWORD is set, the profile-refresh
# re-login and the Naukri apply runner sign in with these directly, which avoids
# Google's anti-automation block. Leave blank only if you sign in to Naukri via Google.
NAUKRI_EMAIL=you@example.com
NAUKRI_PASSWORD=your-naukri-password
# Your Naukri profile page (the default works for every account; change only if Naukri changes its URL)
NAUKRI_PROFILE_URL=https://www.naukri.com/mnjuser/profile
# Resume PDF uploaded to the Naukri profile and attached to external application forms.
# Filename relative to this folder, or an absolute path.
RESUME_FILE=Your Resume.pdf

# --- Other job sites (direct email/password logins) ---
HIRIST_EMAIL=you@example.com
HIRIST_PASSWORD=your-hirist-password
INSTAHYRE_EMAIL=you@example.com
INSTAHYRE_PASSWORD=your-instahyre-password
LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD=your-linkedin-password

# --- Identity / contact ---
NAME=Your Name
EMAIL=you@gmail.com
PHONE=+91 9999999999
LOCATION=City, Country

# --- Profile ---
CURRENT_ROLE=Your Title at YourCompany (City)
COMPANY=YourCompany
EDUCATION=Your Degree, Your Institute (2021-2025)
YEARS_EXPERIENCE=X years professional plus internships
SKILLS=JavaScript, TypeScript, Python, React, Node.js, FastAPI, MongoDB, PostgreSQL, Docker, GCP

# Up to 5 resume highlights, separated by ||
HIGHLIGHTS=First key achievement with impact/numbers||Second achievement||Third achievement||Fourth achievement||Fifth achievement

# --- Application answers ---
# CTC values are in LAKHS, not rupees (application forms are labelled LPA).
# e.g. CURRENT_CTC=12 means 12 LPA; EXPECTED_CTC may be a range like "18-25".
NOTICE_PERIOD=30 days
CURRENT_CTC=0
EXPECTED_CTC=0
DOB=DD/MM/YYYY
GENDER=Prefer not to say
WORK_AUTH=Authorized to work in my country of residence.

# --- Links ---
GITHUB_URL=https://github.com/yourhandle
LINKEDIN_URL=https://www.linkedin.com/in/yourhandle/
PORTFOLIO_URL=https://yourportfolio.com/

# --- Optional: Gemini API key for answering unmatched application questions ---
# Also used (when set) to score each job's relevance against your resume; without a
# key the deterministic keyword/skill-overlap scorer is used instead.
GEMINI_KEY=

# --- Resume-relevance gate ---
# A job is applied to only if it is NOT title-blocklisted AND scores >= this value.
# Range 0-100, default 50. Higher = stricter (fewer, more-relevant jobs).
RELEVANCE_THRESHOLD=50
